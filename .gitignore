# ============================================================
# 주요일정 취합 프로젝트 .gitignore
# 원칙: 코드·양식·설계 문서만 올리고, 실제 업무 데이터는 올리지 않는다.
# ============================================================

# ---------- 1. 실제 업무 데이터 (보안) ----------
# 실처에서 받은 원본 일정 파일 폴더 (예: 261119/, 261120/)
/[0-9][0-9][0-9][0-9][0-9][0-9]/

# 날짜별 작업 폴더: 수신 파일, 취합본, 미리보기, 처리기록, 발송승인, 갱신 기록
/실처일정/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# 주간 임원일정 (보안 사항)
/실처일정/주간임원일정/
/임원일정*.jpg
/임원일정*.png
/임원일정*.hwp
/임원일정*.hwpx

# 실제 주요일정 샘플 (실제 내용이 담긴 원본)
/고객사업본부 주요일정(샘플).hwp

# 발표용 폴더의 날짜별 결과물 (실처 회신 복사본 포함)
#   가상 주간 임원일정(발표용/실처일정/주간임원일정/)은 올려도 됨
/발표용/실처일정/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# 개인 업무 맥락 문서 (기관·소속·담당 업무 등 개인 정보)
/업무_맥락.md

# 발송 승인 파일 (어디에 있든)
발송승인.txt

# ---------- 2. 실행 중 생기는 임시 파일 ----------
__pycache__/
*.py[cod]
*.tmp
*.bmp
*.log

# 한글 임시·백업 파일
~$*
*.asv
*.bak

# ---------- 3. 개인 설정 ----------
.claude/settings.local.json
.env
.env.*

# ---------- 4. Windows / 편집기 ----------
Thumbs.db
desktop.ini
.vscode/
.idea/
